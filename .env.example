# Copia este archivo a .env.local y rellena los valores.
# En Vercel: Settings → Environment Variables.

# Modo demo: datos de ejemplo y cambios en el navegador, sin Supabase.
# Poner a false cuando el cliente tenga Supabase.
NEXT_PUBLIC_DEMO_MODE=true

# URL pública de la web (sin barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Solo servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
